# ---------------------------------------------------------------------------
# prog-log environment. Copy to .env.local for local dev; set the same values
# in Vercel project settings for production. Placeholders only — never commit
# real secrets. docs/RUNBOOK.md walks through obtaining every value.
# ---------------------------------------------------------------------------

# --- Supabase (Dashboard > Project Settings > API) -------------------------
# Public: safe in the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key
# Secret: server-side only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key

# --- App --------------------------------------------------------------------
# Canonical site URL, used for magic-link redirects and absolute links.
NEXT_PUBLIC_SITE_URL=https://log.aidanchien.com

# --- Demo mode (public read-only showcase, ADR-0016) ------------------------
# Set to 1 on the separate demo deployment ONLY. Routes every server read to the
# checked-in CSV fixtures (lib/demo/fixtures/*) instead of Supabase, so the demo
# needs no database and no real credentials. Leave unset for the private app.
DEMO_MODE=

# --- Discord capture (Developer Portal > Your App) --------------------------
# General Information > Public Key — verifies interaction signatures (Ed25519).
DISCORD_PUBLIC_KEY=abcdef0123456789...
# Bot > Token — used only by scripts/register-discord-command.mjs, not at runtime.
DISCORD_BOT_TOKEN=your-bot-token
# General Information > Application ID — for command registration.
DISCORD_APPLICATION_ID=123456789012345678
# Your personal Discord user id (Developer Mode > right-click yourself > Copy ID).
# The /log command only accepts this user.
DISCORD_OWNER_ID=123456789012345678
# Channel webhook URL for the daily Throwback digest (channel > Integrations).
DISCORD_DIGEST_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Owner identity ----------------------------------------------------------
# Email allowed to request a magic link. Other addresses receive the same
# success response without sending email or creating an auth user.
OWNER_EMAIL=owner@example.com
# auth.users id of the single owner account (Supabase Dashboard > Authentication).
# Service-role capture paths (Discord, Apple Shortcut) write entries as this user.
OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# --- Apple Shortcut capture ---------------------------------------------------
# Single-purpose bearer secret for POST /api/log. Generate with:
#   openssl rand -hex 32
SHORTCUT_SECRET=long-random-hex-string

# --- Vercel Cron --------------------------------------------------------------
# Vercel sets CRON_SECRET automatically when defined in project env vars;
# /api/cron/digest requires it as a bearer token. Generate with:
#   openssl rand -hex 32
CRON_SECRET=long-random-hex-string
